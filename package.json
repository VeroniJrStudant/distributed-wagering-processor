{
  "name": "distributed-wagering-processor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun src/main.ts",
    "start:dev": "bun --watch src/main.ts",
    "start:consumer": "bun src/workers/consume.ts",
    "test": "bun test src",
    "test:unit": "bun test src",
    "test:integration": "bun test test/integration",
    "test:concurrency": "bun test test/concurrency",
    "test:all": "bun test src test/integration test/concurrency",
    "test:load": "bun scripts/load.ts",
    "typecheck": "tsc --noEmit",
    "migration:up": "bun src/infrastructure/persistence/migrate.ts up",
    "migration:down": "bun src/infrastructure/persistence/migrate.ts down",
    "docker:up": "docker-compose up -d --build",
    "docker:down": "docker-compose down -v",
    "infra:up": "docker-compose up -d postgres localstack"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.901.0",
    "@mikro-orm/core": "^6.4.16",
    "@mikro-orm/postgresql": "^6.4.16",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "decimal.js": "^10.6.0",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/express": "^5.0.6",
    "@types/node": "^22.18.6",
    "@types/pg": "^8.15.5",
    "typescript": "^5.9.2"
  }
}
